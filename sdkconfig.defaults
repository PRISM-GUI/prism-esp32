# The ESP32-S31-Korvo-1: 16 MB flash, 16 MB PSRAM (WROOM-3 module).
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
# A 3 MB app partition (partitions.csv): the self-test alone fills 82% of the default 1 MB, and
# the scope is over the 1.5 MB of the large preset.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_FREERTOS_HZ=1000

# PRISM is compiled as on every other target: exceptions on, and RTTI (std::any::type()).
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

# One speed for the logs and the profiler dump.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# app_main builds a whole snapshot of an 800x480 view.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384

# Idle-task run time for the timing line: 64-bit (a 32-bit microsecond counter wraps in 71 min),
# counted by the IDF timer (the CPU clock's counter differs per core).
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_HEAP_USE_HOOKS=y

# PRISM's frames are drawn on the CPU: -O2 for the whole firmware, PRISM included (its Meson
# build takes IDF's flags). IDF's default is -Og.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Board-support errors come back as error codes, which the apps print with a hint, instead of
# the BSP aborting on them.
# CONFIG_BSP_ERROR_CHECK is not set

# The panel (boards/korvo1/band_display.cpp). If the picture shifts sideways, PSRAM cannot keep up:
# first try bounce buffers (CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_MODE=y instead of _REFRESH_AUTO),
# then a lower pixel clock. 18 MHz is the board-support package's own.
CONFIG_PRISM_LCD_PCLK_MHZ=18
CONFIG_BSP_LCD_RGB_REFRESH_AUTO=y
# CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_MODE is not set
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=10
# The CPU instead of the PPA for the band copies into the panel buffer (slower; if the PPA fails).
# CONFIG_PRISM_DISPLAY_CPU_COPY is not set
