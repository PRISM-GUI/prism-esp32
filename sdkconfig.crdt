# The app of build/crdt.bin (scripts/build.sh adds this file to sdkconfig.defaults).
CONFIG_PRISM_APP_CRDT=y
# The "PRISM" access point's WPA2 password: 8 to 63 characters.
CONFIG_PRISM_CRDT_AP_PASSWORD="prism-crdt"

# The server (components/prism_crdt_hub: PRISM's crdt::Hub, ESP-IDF body): HTTPS with the
# certificate made at build time, and a WebSocket at /room. A WebSocket handshake never reaches a
# URI handler, so the origin check and the "peer joined" event need the callbacks around it.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
# A browser's request headers (cookies, sec-websocket-*, the wasm fetch's) do not fit anything
# smaller. This is also what the server allocates per request, so it is not raised further.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Seven sockets for the server (five browsers plus its own slack for closing sessions) need the
# three lwIP keeps for itself: the default of 10 is exactly at the limit.
CONFIG_LWIP_MAX_SOCKETS=12

# Each TLS session's buffers go to PSRAM: five of them would not fit the internal RAM the panel
# and PRISM's tree already share.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# The profile recorder's 768 KiB of .bss goes to PSRAM (boards/korvo1/linker.lf). The panel needs
# PSRAM anyway: without it this firmware aborts at boot ("Failed to init external RAM").
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# The render thread's 48 KB stack needs one block of internal RAM, and Wi-Fi took it: on the first
# boot the largest internal block left was 31 KB. Wi-Fi and lwIP buffers may go to PSRAM, and the
# driver's speed-ups stay out of internal RAM (on this chip IRAM is the heap's memory); a few small
# CRDT messages do not need either.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
