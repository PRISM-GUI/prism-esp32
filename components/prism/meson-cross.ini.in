# Generated by components/prism/CMakeLists.txt from ESP-IDF's own compiler and flags.
# The '@<file>' arguments are ESP-IDF's response files (-march, -mabi, the C library's specs):
# the compiler reads the same files ESP-IDF compiles with.
[binaries]
c = ['@PRISM_WRAPPER@', '@PRISM_CC@']
cpp = ['@PRISM_WRAPPER@', '@PRISM_CXX@']
ar = '@PRISM_AR@'
strip = '@PRISM_STRIP@'

[built-in options]
b_staticpic = false
c_args = [@PRISM_C_ARGS@]
cpp_args = [@PRISM_CPP_ARGS@]
c_link_args = [@PRISM_LINK_ARGS@]
cpp_link_args = [@PRISM_LINK_ARGS@]

[properties]
needs_exe_wrapper = true
# What PRISM's yffi subproject cross-builds Yrs for. Both are empty unless the crdt layer is on
# (components/prism's PRISM_CRDT), and empty means Yrs is not built at all: the esp-rs toolchain
# names its target and its rustup toolchain, and no other target builds the Rust library here.
rust_target = '@PRISM_RUST_TARGET@'
rust_toolchain = '@PRISM_RUST_TOOLCHAIN@'

[host_machine]
system = 'none'
cpu_family = 'riscv32'
cpu = '@IDF_TARGET@'
endian = 'little'
