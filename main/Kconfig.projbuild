menu "PRISM firmware"

    # scripts/build.sh picks it per firmware (sdkconfig.<app>); main/<name>.cpp is the app.
    choice PRISM_APP
        prompt "The app this firmware runs"
        default PRISM_APP_SELFTEST

        config PRISM_APP_SELFTEST
            bool "selftest: the on-board checks, on the console"
        config PRISM_APP_WIDGETS
            bool "widgets: the widget demo on the panel"
        config PRISM_APP_SCOPE
            bool "scope: the microphone scope on the panel"
        config PRISM_APP_BTSPIKE
            bool "btspike: Bluetooth audio next to the panel (throwaway spike)"
    endchoice

    config PRISM_APP_NAME
        string
        default "selftest" if PRISM_APP_SELFTEST
        default "widgets" if PRISM_APP_WIDGETS
        default "scope" if PRISM_APP_SCOPE
        default "btspike" if PRISM_APP_BTSPIKE

    config PRISM_UI_SCALE_PERCENT
        int "UI scale of the panel apps, in percent"
        range 100 300
        default 150
        help
            100 draws the widgets at their desktop size, 150 one and a half times larger. A finger
            is bigger than a pointer: raise it if the panel is small or the buttons are hard to hit.

endmenu
