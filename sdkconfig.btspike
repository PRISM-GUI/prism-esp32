# The app of build/btspike.bin (scripts/build.sh adds this file to sdkconfig.defaults).
CONFIG_PRISM_APP_BTSPIKE=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Bluetooth Classic audio only, as ESP-IDF's classic_bt/a2dp_source example.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
# Bluedroid's allocations go to PSRAM first: internal RAM is what the panel runtime needs.
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
